{
  "rules": {
    "users": {
      ".indexOn": ["friendCode"],
      "$uid": {
        ".read": "auth != null",
        "name": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 48"
        },
        "avatar": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length <= 150000"
        },
        "friendCode": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length == 8"
        },
        "createdAt": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "score": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        },
        "sentRequests": {
          ".write": "auth != null",
          "$targetUid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $targetUid)"
          }
        },
        "friendRequests": {
          "$senderUid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $senderUid)"
          }
        },
        "friends": {
          "$friendUid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $friendUid)"
          }
        },
        "roomInvites": {
          "$senderUid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $senderUid)"
          }
        }
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$nameKey": {
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid)"
      }
    },
    "friendCodes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid)"
      }
    },
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "customCategories": {
      ".indexOn": ["isPublished", "creatorUid", "playCount", "createdAt"],
      ".read": "auth != null",
      "$catId": {
        ".write": "auth != null && (!data.exists() ? newData.child('creatorUid').val() == auth.uid : data.child('creatorUid').val() == auth.uid)",
        "playCount": {
          ".write": "auth != null && newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() == data.val() + 1)"
        }
      }
    },
    "spy_rooms": {
      ".indexOn": ["visibility", "status", "createdAt"],
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "spy_quick_match_queue": {
      ".indexOn": ["createdAt"],
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
